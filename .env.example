# ==========================================
# Tech Sentinel Environment Configuration
# ==========================================

# Telegram Nightly Notification Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Generic SMTP / Gmail Newsletter Delivery (Optional - for opted-in email newsletter)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# Web App Base URL (For notifications, reports, and email links)
APP_BASE_URL=https://tech-sentinel-chi.vercel.app

# Optional Public Web App URL (HTTPS only - used for Telegram external buttons)
WEB_APP_URL=https://tech-sentinel-chi.vercel.app

# SQLite Local Database (Auto-created if not set)
DATABASE_PATH=database/tech_sentinel.db

# Cloudflare Worker / D1 Ingestion Bridge (Used in GitHub Actions to push to production D1)
WORKER_API_URL=
INGESTION_SECRET=
