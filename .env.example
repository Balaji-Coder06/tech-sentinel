# ==========================================
# Tech Sentinel Environment Configuration
# ==========================================

# Telegram Nightly Notification Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Web App Base URL (For local web application)
APP_BASE_URL=http://localhost:3000

# Optional Public Web App URL (HTTPS only - used for Telegram external buttons)
WEB_APP_URL=

# SQLite Local Database (Auto-created if not set)
DATABASE_PATH=database/tech_sentinel.db

# Cloudflare Worker / D1 Ingestion Bridge (Used in GitHub Actions to push to production D1)
WORKER_API_URL=
INGESTION_SECRET=
